# setup.py generates a private .env with a random secret for local use.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_SECURE_COOKIES=0
DJANGO_CSRF_TRUSTED_ORIGINS=
APP_TIME_ZONE=UTC
BOT_CONTACT=
# Optional: local model, installed and run separately. No API key is needed.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
# Optional web search. Discovery works without it. Never commit a real key.
BRAVE_SEARCH_ENABLED=0
BRAVE_SEARCH_API_KEY=
# Shared maximum across all campaigns per UTC day; per-campaign limits also apply.
BRAVE_DAILY_SEARCH_LIMIT=20
# Common Crawl index lookups for approved sources (index only). Blank collection = newest.
COMMON_CRAWL_ENABLED=0
COMMON_CRAWL_COLLECTION=
# Rolling window (days) of completed discovery pages used for per-origin yield priority.
DISCOVERY_YIELD_WINDOW_DAYS=60
# Leave unset to use data/leads.sqlite3. Set for PostgreSQL on a server.
# DATABASE_URL=postgresql://clearpay:password@db:5432/clearpay

# Optional Jev classification. A key alone never enables calls. See docs/JEV_TESTING.md.
JEV_MODE=off
JEV_CAPTURE_ENABLED=0
# Review-only fallback: queue typed judgments over bounded code-generated candidate blocks
# when structured data and configured/default person-card selectors find no rows.
JEV_LAYERED_BLOCKS_ENABLED=0
# Opt-in structured data and platform recipe proposals. No API key needed.
EXTRACTION_PACKS_ENABLED=0
JEV_ROUTING_ENABLED=0
TYPESAFE_API_KEY=
JEV_PRICE_CONFIRMED=0
# Import path to a verified full-envelope token counter accepting a request dict.
JEV_TOKEN_COUNTER=
# Explicit calibration override; estimates cannot guarantee the 5,000-token ceiling.
JEV_ALLOW_ESTIMATED_TOKENS=0
# UTC-day spend plus unresolved reservations. Live mode fails closed at 0.
JEV_DAILY_ALLOWANCE_USD=2
